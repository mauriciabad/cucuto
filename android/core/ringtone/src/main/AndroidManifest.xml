<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Phone ringtones (#52, ADR 0039). Runtime permissions, asked only when the user turns phone ringtones on (contacts)
        or picks "random per call" (phone), each with an explanation first:
        - READ_CONTACTS / WRITE_CONTACTS: link a chat to an Android contact and set that contact's ringtone
          (ContactsContract.Contacts.CUSTOM_RINGTONE), the same field the Contacts app changes. Nothing leaves the phone.
        - READ_PHONE_STATE: notice that a call ended, to re-roll "random per call" ringtones. The number is never read.
        RECEIVE_BOOT_COMPLETED (normal) re-schedules the next day/night or season switch after a reboot.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- Both receivers start disabled; RingtoneReceivers enables them only while they have work to do. -->
        <receiver
            android:name=".system.CallEndedReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.READ_PRIVILEGED_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".system.RingtoneEventsReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
