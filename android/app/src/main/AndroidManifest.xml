<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Diagnostics screen's test notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The Feedback engine's rich haptics (VibrationEffect compositions with USAGE_TOUCH). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Android backup and device transfer are off (res/xml/data_extraction_rules.xml).
        android:description is also what LSPosed shows as the module description.
    -->
    <application
        android:name=".CucutoApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cucuto">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Clip provider (#16). Exported because SystemUI's ringtone player opens the clip URI the module swaps in;
            ClipProvider itself refuses every caller except uid 1000 and com.android.systemui, and is read-only.
        -->
        <provider
            android:name=".provider.ClipProvider"
            android:authorities="app.mauri.cucuto.clips"
            android:exported="true"
            android:grantUriPermissions="false"
            tools:ignore="ExportedContentProvider" />

        <!--
            Module events (#17): system_server calls report(...) with batched decisions. ModuleEventProvider refuses
            every caller except uid 1000.
        -->
        <provider
            android:name=".provider.ModuleEventProvider"
            android:authorities="app.mauri.cucuto.events"
            android:exported="true"
            android:grantUriPermissions="false"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
