<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Diagnostics screen's test notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The Feedback engine's rich haptics (VibrationEffect compositions with USAGE_TOUCH). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        Pack repositories (Discover, ADR 0029): only while Discover is open or the user adds a repository. No
        background work, no analytics. The module in system_server never uses the network.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Package visibility (Android 11+): the status card checks that WhatsApp or WhatsApp Business is installed, and
        the clip mirror (ADR 0018) checks that SystemUI, which opens notification sounds, can read shared storage.
        Only these packages, never QUERY_ALL_PACKAGES.
    -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.android.systemui" />
    </queries>

    <!--
        Android backup and device transfer are off (res/xml/data_extraction_rules.xml).
        android:description is also what LSPosed shows as the module description.
    -->
    <application
        android:name=".CucutoApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cucuto">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                "Open with" and the share sheet for packs and bundles (#27, ADR 0007). Packs are plain zips, so these
                match every zip; the importer decides from the contents what the file is and says so plainly.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <!-- Fallback for apps that report application/octet-stream: match a .zip name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathAdvancedPattern=".*\\.[zZ][iI][pP]" />
            </intent-filter>
            <!--
                "Add to app" links from websites and QR codes: cucuto://repo/add?url=… (ADR 0011, ADR 0029). The link
                only fills in Discover's add sheet; the user sees the host and confirms before anything is fetched.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cucuto" />
                <data android:host="repo" />
                <data android:path="/add" />
            </intent-filter>
        </activity>

        <!--
            Clip provider (#16). Exported because SystemUI's ringtone player opens the clip URI the module swaps in;
            ClipProvider itself refuses every caller except uid 1000 and com.android.systemui, and is read-only.
        -->
        <provider
            android:name=".provider.ClipProvider"
            android:authorities="app.mauri.cucuto.clips"
            android:exported="true"
            android:grantUriPermissions="false"
            tools:ignore="ExportedContentProvider" />

        <!--
            Module events (#17): system_server calls report(...) with batched decisions. ModuleEventProvider refuses
            every caller except uid 1000.
        -->
        <provider
            android:name=".provider.ModuleEventProvider"
            android:authorities="app.mauri.cucuto.events"
            android:exported="true"
            android:grantUriPermissions="false"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
