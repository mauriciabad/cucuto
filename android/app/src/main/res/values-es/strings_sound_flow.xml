    <string name="ringtone_choice_section">Otras opciones</string>
    <string name="ringtone_choice_default">Predeterminado de Android</string>
    <string name="ringtone_choice_default_body">Suena con el tono predeterminado de tu móvil. Si el contacto tiene un tono propio, Cucuto lo quita y te lo devuelve si cambias de idea.</string>
    <string name="ringtone_choice_unchanged">Dejar como está</string>
    <string name="ringtone_choice_unchanged_body">Cucuto no toca el tono de este contacto. Si lo cambió antes, el contacto recupera el suyo.</string>
    <string name="ringtone_save_default">Usar el predeterminado de Android</string>
    <string name="ringtone_save_unchanged">Dejar el tono como está</string>

