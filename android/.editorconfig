root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
# Composables are PascalCase functions.
ktlint_function_naming_ignore_when_annotated_with = Composable
# App-wide theme and feedback locals (docs/decisions/0014-theme-and-feedback-engine.md).
# Shared-element scopes for navigation entries (Home and the character picker, #25).
compose_allowed_composition_locals = LocalFeedback,LocalReducedMotion,LocalThemeConditions,LocalEntryAnimatedScope,LocalSharedTransitionScope

[*.{yml,yaml,json}]
indent_size = 2
