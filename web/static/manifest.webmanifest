{
	"id": "/",
	"name": "Cucuto",
	"short_name": "Cucuto",
	"description": "Give each contact a voice: per-contact WhatsApp notification sounds and vibrations for rooted Android 17.",
	"lang": "en",
	"dir": "ltr",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"theme_color": "#FF6B2C",
	"background_color": "#FFF4F0",
	"categories": ["utilities", "personalization"],
	"icons": [
		{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{
			"src": "/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"file_handlers": [
		{
			"action": "/open/",
			"accept": { "application/vnd.cucuto.soundpack+zip": [".soundpack"] }
		}
	]
}
