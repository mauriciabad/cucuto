<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".app.SpikeApp"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@android:drawable/sym_call_incoming"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!--
          Modern libxposed modules are declared by META-INF/xposed/* (java_init.list, module.prop,
          scope.list). No activity: the device session is driven from adb (README.md).
        -->

        <!--
          Writes the spike's settings (mode, test contact name, ring URI) to libxposed Remote
          Preferences. Exported only to holders of DUMP, which in practice is the adb shell.
        -->
        <receiver
            android:name=".app.ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
