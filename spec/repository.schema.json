{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cucuto.mauri.app/spec/v1/repository.schema.json",
  "title": "Cucuto pack repository index (repository.json)",
  "description": "Index served by a pack repository. Relative URLs resolve against the URL the index was fetched from. Generated by `packer index`. Human spec: docs/pack-format.md.",
  "type": "object",
  "required": ["formatVersion", "name", "packs"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "name": { "$ref": "common.schema.json#/$defs/name" },
    "description": { "$ref": "common.schema.json#/$defs/description" },
    "homepage": { "$ref": "common.schema.json#/$defs/httpsUrl" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "packs": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "patternProperties": { "^x-": true },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "description": "One downloadable pack or bundle zip (conventionally <name>.soundpack.zip). IDs are unique within an index.",
      "type": "object",
      "required": ["id", "type", "name", "version", "download"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/packId" },
        "type": { "enum": ["pack", "bundle"] },
        "packFormatVersion": { "description": "formatVersion of the downloadable file, so apps can skip what they cannot read before downloading. Default 1.", "type": "integer", "minimum": 1, "default": 1 },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "version": { "$ref": "common.schema.json#/$defs/version" },
        "author": { "$ref": "common.schema.json#/$defs/author" },
        "license": { "$ref": "common.schema.json#/$defs/license" },
        "description": { "$ref": "common.schema.json#/$defs/description" },
        "tags": { "$ref": "common.schema.json#/$defs/tags" },
        "cover": { "$ref": "common.schema.json#/$defs/urlReference" },
        "characters": {
          "description": "Preview of a pack's characters (type pack only).",
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/characterPreview" }
        },
        "packs": {
          "description": "The packs inside a bundle (type bundle only), so apps can show the contents before downloading.",
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/bundledPack" }
        },
        "sizeUnpacked": { "description": "Total uncompressed size in bytes.", "type": "integer", "minimum": 0 },
        "download": { "$ref": "#/$defs/download" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "bundle" } } },
          "then": { "required": ["packs"], "not": { "required": ["characters"] } },
          "else": { "not": { "required": ["packs"] } }
        }
      ],
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "bundledPack": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/packId" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "version": { "$ref": "common.schema.json#/$defs/version" },
        "license": { "$ref": "common.schema.json#/$defs/license" },
        "cover": { "$ref": "common.schema.json#/$defs/urlReference" },
        "characters": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/characterPreview" }
        }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "characterPreview": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "sprite": { "$ref": "common.schema.json#/$defs/urlReference" },
        "sample": { "description": "A short preview clip.", "$ref": "common.schema.json#/$defs/urlReference" },
        "seedColor": { "$ref": "common.schema.json#/$defs/color" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "download": {
      "type": "object",
      "required": ["url", "size", "sha256"],
      "properties": {
        "url": { "$ref": "common.schema.json#/$defs/urlReference" },
        "size": { "description": "Exact file size in bytes; checked before and after downloading.", "type": "integer", "minimum": 22 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
