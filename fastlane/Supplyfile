# Settings for `fastlane supply`, which uploads Cucuto's bundle and store listing to Google Play (ADR 0071).
#
# Only the owner runs it, from the repository root (docs/releasing.md, "Upload to Google Play"). No workflow runs
# it. It reads the service account key from SUPPLY_JSON_KEY (a file path) or SUPPLY_JSON_KEY_DATA (the JSON itself);
# never put the key in this repository. Command-line options override these, e.g.:
#
#   SUPPLY_JSON_KEY=~/cucuto-release-key/play-service-account.json \
#     fastlane supply --aab cucuto-1.0.0.aab
#
# Configuration only, in fastlane's Ruby syntax; the project's tools stay in Kotlin.

package_name("app.mauri.cucuto")

# The same listing F-Droid, IzzyOnDroid and Obtainium read: titles, descriptions, changelogs/<versionCode>.txt,
# icon, feature graphic and screenshots, in en-US and es-ES.
metadata_path("fastlane/metadata/android")

# Internal testing first. Closed testing (Play's required 12 testers for 14 days) and production are promoted in
# Play Console, by hand.
track("internal")

# A draft never reaches anyone until the owner rolls it out in Play Console. Play only accepts drafts for an app
# that was never published.
release_status("draft")

# Cucuto ships one bundle per release; the APK stays on GitHub. The bundle already carries R8's mapping and the
# native debug symbols (BUNDLE-METADATA), so no separate mapping upload.
skip_upload_apk(true)
